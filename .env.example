# ========================
# MinerU 文档解析服务配置
# ========================

# --- 基础配置 ---
# MinerU API 基础地址
MINERU_BASE_URL=https://mineru.net

# --- 精准解析 API 配置 ---
# API Token，在 MinerU API 管理页面创建
# 精准解析 API 需要此配置
MINERU_API_TOKEN=''

# 默认模型版本：pipeline / vlm / MinerU-HTML
MINERU_DEFAULT_MODEL_VERSION=vlm

# --- 解析默认参数 ---
# 是否开启 OCR（默认 false）
MINERU_IS_OCR=false
# 是否开启公式识别（默认 true）
MINERU_ENABLE_FORMULA=true
# 是否开启表格识别（默认 true）
MINERU_ENABLE_TABLE=true
# 文档语言（默认 ch，即中英文）
MINERU_LANGUAGE=ch

# --- 轮询配置 ---
# 轮询超时时间（秒）
MINERU_POLL_TIMEOUT=300
# 轮询间隔（秒）
MINERU_POLL_INTERVAL=3

# --- 缓存配置 ---
# 是否绕过缓存（默认 false）
MINERU_NO_CACHE=false
# 缓存容忍时间（秒，默认 900 即 15 分钟）
MINERU_CACHE_TOLERANCE=900
